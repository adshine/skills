#!/bin/bash
# pm-blocked-watch <workspace-id> [manager-pane] [interval-seconds]
# Requires Herdr (https://github.com/herdrdev/herdr) and jq.
# Run in the background (host background shell, not a pane). Exits with one
# line per worker the moment any worker in the workspace is `blocked` (showing
# a permission prompt or a question), so the exit wakes the manager. Re-arm it
# after answering. Doorbells only fire when a worker finishes; a worker stuck
# on a prompt never rings, which is what this catches.
set -u
ws="${1:?workspace id}"; me="${2:-${HERDR_PANE_ID:-}}"; every="${3:-30}"
while :; do
  b=$(herdr agent list 2>/dev/null | jq -r --arg w "$ws:" --arg me "$me" \
    '.result.agents[] | select((.pane_id|startswith($w)) and .pane_id!=$me and .agent_status=="blocked") | [.name // "-", .pane_id] | @tsv')
  [ -n "$b" ] && { echo "BLOCKED:"; echo "$b"; exit 0; }
  sleep "$every"
done
