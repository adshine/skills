#!/bin/bash
# pm-blocked-watch <workspace-id> [manager-pane] [interval-seconds] [--board <board-dir>]
# Requires Herdr (https://github.com/herdrdev/herdr) and jq.
# Run in the background (host background shell, not a pane). Exits with one
# line per worker the moment any worker in the workspace is `blocked` (showing
# a permission prompt or a question), so the exit wakes the manager. Re-arm it
# after answering. Doorbells only fire when a worker finishes; a worker stuck
# on a prompt never rings, which is what this catches. With --board, the panes
# named in <board>/manager and <board>/front are skipped too: a prompt on the
# front desk is the user's own.
set -u
board=""; pos=()
while [ $# -gt 0 ]; do case "$1" in --board) board="${2/#\~/$HOME}"; shift 2;; *) pos+=("$1"); shift;; esac; done
ws="${pos[0]:?workspace id}"; me="${pos[1]:-${HERDR_PANE_ID:-}}"; every="${pos[2]:-30}"
skip="$(cat "$board/manager" "$board/front" 2>/dev/null | head -2 | tr '\n' ' ')"
while :; do
  b=$(herdr agent list 2>/dev/null | jq -r --arg w "$ws:" --arg me "$me" --arg skip " $skip" \
    '.result.agents[] | select((.pane_id|startswith($w)) and .pane_id!=$me and .agent_status=="blocked")
      | select(.pane_id as $p | (.name // "") as $n | ($skip | contains(" " + $p + " ")) or ($n != "" and ($skip | contains(" " + $n + " "))) | not) | [.name // "-", .pane_id] | @tsv')
  [ -n "$b" ] && { echo "BLOCKED:"; echo "$b"; exit 0; }
  sleep "$every"
done
